# ---------------------------------------------------------------------------
# HTML Hero — environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project. `.env.local` is git-ignored and must never be committed.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Public (safe in the browser) ------------------------------------------
#
# Both values below are shipped to the browser by design. The anon key is
# meant to be public: it identifies your project but grants no access on its
# own, because Row Level Security decides what any given request may read or
# write. Find them in Supabase under Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The canonical origin, used to build the redirect URLs in confirmation and
# password-reset emails. In development this is http://localhost:3000; in
# production set it to your real domain, with no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Server-only (NEVER expose to the browser) -----------------------------
#
# The service-role key bypasses Row Level Security entirely. It is needed only
# by local tooling — loading the seed, administrative maintenance — and is read
# exclusively through `serverEnv()` in src/lib/env.ts, which throws if it is
# ever reached from client code.
#
# Do not add this to your hosting provider's environment unless you have a
# specific server-side need for it. This application does not require it at
# runtime.

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

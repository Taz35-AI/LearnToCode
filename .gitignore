# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js
.next/
out/
build/
next-env.d.ts

# Environment — never commit real credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage/
.vitest/

# TypeScript
*.tsbuildinfo

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python tooling used by the media generator
__pycache__/
*.pyc
.venv/
venv/

# Vercel
.vercel

# Generated media is committed on purpose — see README "Media asset setup".
# The generator's summary file is not needed in version control.
public/learning-media/generated.json

# Agent tooling and worktrees. The main checkout keeps its git worktrees under
# .claude/, so committing this directory would nest a checkout inside itself.
.claude/

# Supabase CLI local state: which project is linked, cached version numbers.
# Machine-specific, and regenerated by `supabase link`.
supabase/.temp/

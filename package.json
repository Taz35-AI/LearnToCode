{
  "name": "html-hero",
  "version": "1.0.0",
  "private": true,
  "description": "HTML Hero \u2014 a mastery-based interactive learning platform that takes a complete beginner to advanced, production-quality HTML.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run media:verify && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "media:generate": "node scripts/generate-media.mjs",
    "media:verify": "tsx scripts/verify-media.ts",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "seed:split": "tsx scripts/split-seed.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:rls": "bash scripts/test-rls.sh",
    "media:attribution": "tsx scripts/generate-attribution.ts"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@uiw/react-codemirror": "^4.25.11",
    "next": "^16.2.12",
    "node-html-parser": "^9.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
